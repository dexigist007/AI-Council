{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Plugins (dialog, sql, fs) are added per phase with minimal scope.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "core:window:allow-start-dragging"
  ]
}
